{
  "name": "pi-review-debt",
  "version": "0.1.0",
  "description": "Review-debt tracker for the Pi coding agent: records code-review findings as durable per-repo debt, auto-detects likely-fixed findings via git blob change detection, and surfaces open debt to the model and the user.",
  "type": "module",
  "license": "MIT",
  "author": "SairaDev02",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SairaDev02/pi-tools-saira.git",
    "directory": "pi-review-debt"
  },
  "homepage": "https://github.com/SairaDev02/pi-tools-saira/tree/main/pi-review-debt#readme",
  "bugs": {
    "url": "https://github.com/SairaDev02/pi-tools-saira/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "pi",
    "pi-coding-agent",
    "pi-extension",
    "code-review",
    "review-debt",
    "tracking",
    "pi-package"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@earendil-works/pi-tui": "0.87.1",
    "@types/node": "22.19.0",
    "typebox": "1.3.34",
    "typescript": "7.0.2"
  },
  "scripts": {
    "test": "node --experimental-strip-types tests/review-debt.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "prepublishOnly": "npm test && npm run typecheck"
  },
  "pi": {
    "extensions": ["./src/review-debt.ts"]
  },
  "files": ["src", "tests", "README.md", "LICENSE"],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  }
}
